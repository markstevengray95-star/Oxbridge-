    "test:interview-realism-phase13": "node --experimental-strip-types --test tests/interview-realism-phase13.test.mjs",
    "test:assessment-intelligence": "node --experimental-strip-types --test tests/assessment-intelligence.test.mjs",
    "test:schools-pathways": "node --experimental-strip-types --test tests/phase15-schools-pathways.test.mjs",
    "test:navigation": "node --experimental-strip-types tests/mobile-navigation.cjs",
    "test:student-home": "node --experimental-strip-types --test tests/phase18-student-home.test.mjs",
    "test:consolidation": "node --experimental-strip-types --test tests/phase19-consolidation.test.mjs"
