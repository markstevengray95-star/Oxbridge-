# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://klqwhcnboijianbmrsbz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GDNTxEP7mlcKKFCB5upo0Q_qu5jA9Dy

# Supabase server-only admin key. Prefer a modern sb_secret_... key.
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Optional comma-separated administrator login emails.
# Server-only: matching signed-in accounts are promoted into the protected app_admins table.
ADMIN_EMAILS=

# Existing Gemini Live configuration
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional legacy OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Stripe subscription configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Monthly Stripe prices. Existing legacy IDs remain supported as monthly fallbacks.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_SCHOOL_MONTHLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SCHOOL_PRICE_ID=

# Annual Stripe prices.
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_SCHOOL_ANNUAL_PRICE_ID=

# Recurring add-on price for one additional School account (£5.99/month each).
# Create one monthly recurring Stripe Price at £5.99 and paste its price_... ID here.
STRIPE_SCHOOL_EXTRA_SEAT_PRICE_ID=

# Public-facing GBP prices. These control display only; Stripe Price objects remain authoritative at checkout.
PRO_MONTHLY_PRICE_GBP=14.99
PRO_ANNUAL_PRICE_GBP=119
SCHOOL_MONTHLY_PRICE_GBP=59
SCHOOL_ANNUAL_PRICE_GBP=499
SCHOOL_EXTRA_SEAT_MONTHLY_PRICE_GBP=5.99

# Server-enforced Gemini Live monthly allowances.
# Each successful Live session reserves GEMINI_SESSION_RESERVATION_MINUTES.
FREE_GEMINI_MONTHLY_MINUTES=15
PRO_GEMINI_MONTHLY_MINUTES=240
SCHOOL_GEMINI_MONTHLY_MINUTES=600
GEMINI_SESSION_RESERVATION_MINUTES=15
