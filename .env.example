# Server-only OpenAI configuration.
# Never expose these values through NEXT_PUBLIC_* variables or commit a real key.
OPENAI_API_KEY=

# Optional text interviewer model.
OPENAI_MODEL=gpt-5.6-luna

# Optional realtime voice model and voice.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
